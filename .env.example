# 复制本文件为 .env 并填写真实值（.env 含密钥，已在 .gitignore 中，不会被提交）

# GitHub OAuth（后台管理登录用，桌面应用可留空）
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 投稿功能使用的 GitHub 仓库
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BRANCH=main
GITHUB_PAT=

# NextAuth 配置
NEXTAUTH_URL=http://localhost:3000
AUTH_SECRET=

# API 地址
NEXT_PUBLIC_API_URL=http://localhost:3000

# Google Analytics（可选）
GA_ID=