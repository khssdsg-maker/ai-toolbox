{
  "appId": "com.ai-toolbox.app",
  "productName": "AI万能工具箱",
  "icon": "build/icon.png",
  "directories": {
    "output": "dist-electron"
  },
  "files": [
    "electron/main.mjs",
    "electron/tab-bar.html",
    "electron/tab-preload.cjs",
    "electron/main-preload.cjs",
    "!node_modules/**/*",
    "!node_modules"
  ],
  "extraResources": [
    {
      "from": "out",
      "to": "web"
    }
  ],
  "asar": true,
  "publish": {
    "provider": "github",
    "owner": "khssdsg-maker",
    "repo": "ai-toolbox",
    "releaseType": "release"
  },
  "win": {
    "icon": "build/icon.png",
    "target": ["nsis"]
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "AI万能工具箱",
    "artifactName": "AI万能工具箱-安装程序.exe"
  }
}
