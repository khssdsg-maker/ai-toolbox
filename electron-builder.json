{
  "appId": "com.ai-toolbox.app",
  "productName": "AI万能工具箱",
  "directories": {
    "output": "dist-electron"
  },
  "files": [
    "electron/**/*",
    ".next/**/*",
    "public/**/*",
    "node_modules/**/*",
    "package.json"
  ],
  "win": {
    "target": ["nsis"],
    "icon": "public/assets/images/alogo.webp"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true
  }
}
