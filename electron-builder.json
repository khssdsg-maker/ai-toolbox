{
  "appId": "com.ai-toolbox.app",
  "productName": "AI万能工具箱",
  "directories": {
    "output": "dist-electron"
  },
  "files": [
    "electron/main.mjs"
  ],
  "extraResources": [
    {
      "from": "out",
      "to": "web"
    }
  ],
  "asar": true,
  "win": {
    "target": ["nsis"]
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "AI万能工具箱",
    "artifactName": "AI万能工具箱-安装程序.exe"
  }
}
